        "richtext_pWhaNf": {
          "type": "richtext",
          "settings": {
            "text": "<p>Immunocosmetology is a contemporary skincare direction that works with the skin’s<strong> internal defence resources</strong>, rather than merely addressing irritation or inflammation symptoms.</p><p>Unlike traditional care, immunocosmetics don’t mask symptoms — they <strong>modulate local (epidermal) immunity</strong>, helping the skin restore balance, reduce reactivity, and maintain stable barrier function.</p>",
            "text_size": 16
          }
        }
      },
