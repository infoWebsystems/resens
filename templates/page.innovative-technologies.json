        "heading_pYDxdA": {
          "type": "heading",
          "settings": {
            "heading": "SLOW BEAUTY PHILOSOPHY"
          }
        },
        "richtext_CbMjPy": {
          "type": "richtext",
          "settings": {
            "text": "<p><strong>Re[Sens] rejects instant results at any cost.</strong><br/>We choose a balanced, delicate approach that respects the natural rhythm of the skin.<br/>The Slow Beauty philosophy is more than skincare — it’s a way of life, emphasizing time for self-care, body awareness, and patience. Slow Beauty is the art of caring without haste. Delicacy over aggression. Results that stem from self-respect.</p><p><strong>LESS IS MORE</strong> — our guiding principle.<br/>Our formulas contain only what is necessary. Every ingredient serves a purpose and works in synergy without overstimulating the skin. Excess active ingredients can trigger irritation or disrupt natural regenerative mechanisms.</p><p>And if anything is abundant in our formulas — it’s anti-inflammatory, hydrating, and soothing ingredients that nurture the skin and support its health.</p>",
            "text_size": 16
          }
        }
      },
