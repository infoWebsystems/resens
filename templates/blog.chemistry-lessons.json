        "html_iiCp7m": {
          "type": "html",
          "settings": {
            "code": "<div style=\"text-align: center;\">\n  <h3 style=\"margin-bottom: 20px;\">We talk about:</h3>\n  <div style=\"display: inline-block; text-align: center;\">\n    <div style=\"border: 1px solid #ccc; border-radius: 5px; padding: 10px; margin: 5px 0;\">\n      how skincare really works\n    </div>\n    <div style=\"border: 1px solid #ccc; border-radius: 5px; padding: 10px; margin: 5px 0;\">\n      what modern ingredients are: exosomes, peptides, lipids, enzymes — and why your skin needs them\n    </div>\n    <div style=\"border: 1px solid #ccc; border-radius: 5px; padding: 10px; margin: 5px 0;\">\n      why understanding your microbiome matters\n    </div>\n    <div style=\"border: 1px solid #ccc; border-radius: 5px; padding: 10px; margin: 5px 0;\">\n      global trends, biotechnology, and the direction science is heading\n    </div>\n    <div style=\"border: 1px solid #ccc; border-radius: 5px; padding: 10px; margin: 5px 0;\">\n      marketing myths — and how to spot an “empty promise” versus evidence-based results\n    </div>\n  </div>\n</div>",
            "width": "100%"
          }
