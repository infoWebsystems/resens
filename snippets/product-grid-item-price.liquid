{% comment %}
  Check if the product is on sale and set a variable to be used below.
{% endcomment %}
{% assign on_sale = false %}
{% if product.compare_at_price > product.price %}
  {% assign on_sale = true %}
{% endif %}

{% comment %}
  Check if the product is sold out and set a variable to be used below.
{% endcomment %}
{% assign sold_out = true %}
{% if product.available %}
  {% assign sold_out = false %}
{% endif %}

{% comment %}
  You can show a leading 'from' or 'up to' by checking 'product.price_varies'
  if your variants have different prices.
{% endcomment %}
<a href="{{ product.url | within: collection }}" data-product-id="{{ product.id }}" tabindex="-1">
  {% if on_sale %}

    {% if product.price_varies %}
      {{ 'products.general.from_text' | t }}
    {% endif %}

    <span class="money price-line-through sale-price">
      <span class="visually-hidden">{{ 'products.general.regular_price' | t }}</span>
      <span class="money-resens">{{- product.compare_at_price | money -}}</span>
    </span>

    <span class="money money-resens">{{ product.price | money }}</span>

  {% else %}

    {% if product.price_varies %}
      {{ 'products.general.from_text' | t }} <span class="money money-resens">{{ product.price | money }}</span>
    {% else %}
    {% assign current_language = shop.locale | split: "-" | first %}
    {% assign is_accessories = false %}
    {% for collection in product.collections %}
      {% if collection.handle == "accessories" %}
        {% assign is_accessories = true %}
      {% endif %}
    {% endfor %}

    {% if current_language == 'en' %}
      {% comment %} DELETE START {% endcomment %}
      {% if is_accessories %}
        <span class="money money-resens">{{ product.metafields.elasty.price }}€</span>
      {% else %}
        <span class="money-resens discount--line-through">{{ product.metafields.elasty.price }}€</span>
        <span class="money money-resens" style="font-weight: 700;">{{ product.metafields.elasty.price | divided_by: 4 | times: 3 }}€</span>
      {% endif %}
      {% comment %} DELETE END {% endcomment %}

      {% comment %} <span class="money money-resens">{{ product.metafields.elasty.price }}€</span> {% endcomment %}
    {% else %}
      {% comment %} DELETE START {% endcomment %}

      {% if is_accessories %}
        <span class="money money-resens">{{ product.price | money }}</span>
      {% else %}
        <span class="money-resens discount--line-through">{{ product.price | money }}</span>
        <span class="money money-resens" style="font-weight: 700;">{{ product.price | divided_by: 4 | times: 3 | money }}</span>
      {% endif %}
      {% comment %} DELETE END {% endcomment %}

      {% comment %} <span class="money money-resens">{{ product.price | money }}</span> {% endcomment %}
    {% endif %}
    {% endif %}

  {% endif %}

  {% assign first_variant = product.variants[0] %}
  {% render 'unit-price-measurement-variant', variant: first_variant %}
</a>
