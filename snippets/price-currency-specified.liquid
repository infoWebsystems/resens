{% comment %}
  Renders either one price (amount) for all localization currencies OR one price/amount for each specified currency.

  For one price, use with any numerical value. E.g. '10'.
  For multiple currencies, it must use the following format: 'USD:10, EUR:9, GBP:8'

  Accepts:
  - price: {Str} a single price or prices with correspondent currency code.
  - compare_price: {Str} (optional) same format as price. If > price, shows as crossed out.
  - add_divider: {Bool} whether to prepend a vertical bar to the output value or not.
{% endcomment %}

{%- liquid
  assign prices = price | default: '' | remove: ' ' | split: ','
  assign matching_currency = false
  assign price_amount = ''

  if prices.size > 1
    for p in prices
      assign parts = p | split: ':'
      assign code = parts | first | upcase
      if code == localization.country.currency.iso_code
        assign price_amount = parts | last
        assign matching_currency = true
        break
      endif
    endfor
  else
    assign price_amount = price
    assign matching_currency = true
  endif

  assign price_num = price_amount | plus: 0

  assign compare_amount = ''
  assign compare_num = 0

  if compare_price != blank
    assign compares = compare_price | remove: ' ' | split: ','

    if compares.size > 1
      for c in compares
        assign cparts = c | split: ':'
        assign ccode = cparts | first | upcase
        if ccode == localization.country.currency.iso_code
          assign compare_amount = cparts | last
          break
        endif
      endfor
    else
      assign compare_amount = compare_price
    endif

    assign compare_num = compare_amount | plus: 0
  endif

  assign currency_symbol = localization.country.currency.symbol
  assign currency_price = price_num | times: 100 | money_without_currency | prepend: currency_symbol
  assign currency_compare = compare_num | times: 100 | money_without_currency | prepend: currency_symbol
-%}

{% if matching_currency and price_num > 0 %}
  {% if add_divider == false %}<span class="event-item--subheading">{% else %} | {% endif %}
    <span class="money-resens">
      {{ currency_price }}
    </span>

    {% if compare_price != blank and compare_num > price_num %}
      <span class="money-resens" style="text-decoration: line-through; margin-left: 10px;">
        {{ currency_compare }}
      </span>
    {% endif %}
  {% if add_divider == false %}</span>{% endif %}
{% endif %}
