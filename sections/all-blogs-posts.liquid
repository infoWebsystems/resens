<div class="all-blogs-posts" id="blog-posts-app">
  <div class="blog-posts-grid">
    {% assign blog_handles = "news,coverage,articles,chemistry-lessons,podcasts,sensitivity-sensuality" | split: "," %}
    {% assign all_articles = '' | split: '' %}
    {% for handle in blog_handles %}
      {% assign blog = blogs[handle] %}
      {% if blog != blank %}
        {% assign all_articles = all_articles | concat: blog.articles %}
      {% endif %}
    {% endfor %}
    {% assign sorted_articles = all_articles | sort: "published_at" | reverse %}

    {% for article in sorted_articles %}
      <div class="blog-post-card" data-title="{{ article.title | escape }}">
        {% if article.image %}
          <a href="{{ article.url }}">
            <img src="{{ article.image | img_url: '800x800' }}" alt="{{ article.title | escape_once }}">
          </a>
        {% endif %}
        <h3 class="article-title">
          <a href="{{ article.url }}">{{ article.title }}</a>
        </h3>
        <p class="article-date">{{ article.published_at | date: "%B %d, %Y" }}</p>
        <p class="article-excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 25 }}</p>
        <p class="read-more-link">
          <a href="{{ article.url }}">{{ 'blogs.article.read_more' | t }} →</a>
        </p>
      </div>
    {% endfor %}
  </div>

  <div class="custom-pagination" id="pagination-controls"></div>
</div>

<style>
  .blog-posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 32px;
    max-width: 1200px;
    margin: 0 auto;
  }
  .blog-post-card { display: none; }
  .custom-pagination {
    text-align: center;
    margin-top: 40px;
  }
  .custom-pagination a,
  .custom-pagination .current {
    display: inline-block;
    margin: 0 8px;
    padding: 8px 12px;
    border: 1px solid #ddd;
    border-radius: 4px;
    text-decoration: none;
    color: #333;
    font-weight: 500;
    cursor: pointer;
  }
  .custom-pagination .current {
    background-color: #000;
    color: #fff;
    pointer-events: none;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const cards = document.querySelectorAll(".blog-post-card");
    const perPage = 6;
    const totalPages = Math.ceil(cards.length / perPage);
    const pagination = document.getElementById("pagination-controls");

    function showPage(page) {
      cards.forEach((card, index) => {
        card.style.display = (index >= (page - 1) * perPage && index < page * perPage) ? "block" : "none";
      });
      renderPagination(page);
    }

    function renderPagination(currentPage) {
      pagination.innerHTML = "";
      for (let i = 1; i <= totalPages; i++) {
        const link = document.createElement("a");
        link.textContent = i;
        if (i === currentPage) {
          link.classList.add("current");
        }
        link.addEventListener("click", function() {
          showPage(i);
        });
        pagination.appendChild(link);
      }
    }

    if (cards.length > 0) {
      showPage(1);
    }
  });
</script>
