{% schema %}
{
  "name": "Image Slider",
  "settings": [],
  "blocks": [
    {
      "type": "image",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Slide image"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Image Slider"
    }
  ]
}
{% endschema %}

<div class="slider-wrapper">
  <div class="slider">
    {% for block in section.blocks %}
      {% if block.settings.image %}
        <div class="slide">
          <img src="{{ block.settings.image | img_url: '800x' }}" alt="Slide {{ forloop.index }}">
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

<style>
  .slider-wrapper { max-width: 100%; overflow: hidden; }
  .slider { display: flex; gap: 10px; overflow-x: scroll; scroll-snap-type: x mandatory; }
  .slide { flex: 0 0 auto; scroll-snap-align: start; }
  .slide img { max-width: 100%; height: auto; border-radius: 8px; }
</style>

