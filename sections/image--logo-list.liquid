{% style %}
.logo-bar {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 30px;
  justify-items: center;
}

.logo-bar__item {
  width: 400px;
  height: 400px;
  max-width: 100%;
  max-height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.logo-bar__item img,
.logo-bar__item .logo-bar__image {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
}
{% endstyle %}

<div
  class="homepage-sections-wrapper {{ color_scheme }}"
  data-wetheme-section-type="image--logo-list"
  data-wetheme-section-id="{{ section.id }}"
>
  <div class="wrapper show-on-scroll logo-bar-section--{{ section.id }}">

    {% if section.settings.title != blank %}
      <div class="sitewide--title-wrapper">
        <h2 class="homepage-sections--title">{{ section.settings.title | escape }}</h2>
      </div>
    {% endif %}

    <div class="logo-bar">
      {% for block in section.blocks %}
        <div class="logo-bar__item" {{ block.shopify_attributes }}>
          {% if block.settings.link != blank %}
            <a href="{{ block.settings.link }}" class="logo-bar__link">
          {% endif %}
          {% if block.settings.image != blank %}
            <img
              src="{{ block.settings.image | img_url: '800x800' }}"
              alt="{{ block.settings.image.alt | escape }}"
              class="logo-bar__image"
            />
          {% else %}
            {{ 'logo' | placeholder_svg_tag: 'icon icon--placeholder' }}
          {% endif %}
          {% if block.settings.link != blank %}
            </a>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    {% if section.blocks.size == 0 %}
      <div class="placeholder-noblocks">
        {{ 'general.onboarding.no_content' | t }}
      </div>
    {% endif %}

  </div>
</div>
