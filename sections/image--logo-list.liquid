<link rel="preload" href="{{ 'section-logo-list.min.css' | asset_url }}" as="style" onload="this.onload=null;this.rel='stylesheet'" />
<noscript>{{ 'section-logo-list.min.css' | asset_url | stylesheet_tag }}</noscript>

{% case section.settings.colors %}
  {% when 'white' %}
    {%- assign color_scheme = 'homepage-sections-wrapper--white' -%}
  {% when 'light' %}
    {%- assign color_scheme = 'homepage-sections-wrapper--light' -%}
  {% when 'accent' %}
    {%- assign color_scheme = 'homepage-sections-wrapper--accent' -%}
  {% when 'dark' %}
    {%- assign color_scheme = 'homepage-sections-wrapper--dark' -%}
{% endcase %}

<div class="homepage-sections-wrapper {{ color_scheme }}" data-wetheme-section-type="image--logo-list" data-wetheme-section-id="{{ section.id }}">
  <div class="wrapper show-on-scroll logo-bar-section--{{ section.id }}">
    {% if section.settings.title != blank %}
      <div class="sitewide--title-wrapper">
        <h2 class="homepage-sections--title">{{ section.settings.title | escape }}</h2>
      </div>
    {% endif %}

    <div>
      {% if section.blocks.size > 0 %}
        <div class="logo-bar">
          {% for block in section.blocks %}
            <div class="logo-bar__item" {{ block.shopify_attributes }}>
              {% if block.settings.link != blank %}
                <a href="{{ block.settings.link }}" class="logo-bar__link">
              {% endif %}
              {% if block.settings.image != blank %}
                <img
                  src="{{ block.settings.image | image_url: width: 800 }}"
                  alt="{{ block.settings.image.alt | escape }}"
                  class="logo-bar__image"
                  loading="lazy"
                  width="{{ section.settings.width }}"
                  height="{{ section.settings.height }}"
                />
              {% else %}
                {{ 'logo' | placeholder_svg_tag: 'icon icon--placeholder' }}
              {% endif %}
              {% if block.settings.link != blank %}
                </a>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      {% else %}
        <div class="placeholder-noblocks">
          {{ 'general.onboarding.no_content' | t }}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% style %}
.logo-bar {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 30px;
  justify-items: center;
}

.logo-bar__item {
  width: {{ section.settings.width }}px;
  height: {{ section.settings.height }}px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.logo-bar__image {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
}

@media screen and (max-width: 767px) {
  .logo-bar {
    grid-template-columns: 1fr;
  }

  .logo-bar__item {
    width: 100%;
    height: auto;
  }

  .logo-bar__image {
    width: 100%;
    height: auto;
  }
}
{% endstyle %}

{% schema %}
{
  "name": "t:sections.image--logo-list.name",
  "class": "homepage-section--logo-bar-wrapper show-on-scroll",
  "max_blocks": 20,
  "settings": [
    {
      "type": "select",
      "id": "colors",
      "label": "t:all.Color_scheme",
      "default": "light",
      "options": [
        { "value": "white", "label": "t:sections.image--logo-list.settings.colors.options.white" },
        { "value": "light", "label": "t:all.Light" },
        { "value": "accent", "label": "t:all.Feature" },
        { "value": "dark", "label": "t:all.Dark" }
      ],
      "info": "t:sections.image--logo-list.settings.colors.info"
    },
    {
      "type": "range",
      "id": "width",
      "label": "t:all.Logo_width",
      "min": 100,
      "max": 400,
      "step": 10,
      "unit": "t:all.px",
      "default": 400
    },
    {
      "type": "range",
      "id": "height",
      "label": "Logo height",
      "min": 100,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 400
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:all.Heading",
      "default": "They write about us"
    }
  ],
  "blocks": [
    {
      "type": "logo_image",
      "name": "t:all.Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:all.Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:all.Link",
          "info": "t:all.Optional"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.image--logo-list.presets.name",
      "blocks": [
        { "type": "logo_image" },
        { "type": "logo_image" },
        { "type": "logo_image" },
        { "type": "logo_image" }
      ]
    }
  ],
  "disabled_on": {
    "groups": [ "header" ]
  }
}
{% endschema %}
